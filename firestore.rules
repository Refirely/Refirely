rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access unless explicitly allowed
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        (request.auth.token.email.lower() == 'ganesh.indireddy@gmail.com' ||
         request.auth.token.email.lower() == 'ganesh.photolife@gmail.com');
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidInterestLevel(level) {
      return level in [
        'Top Contender',
        'Strong Interest',
        'Moderate Interest',
        'Casual Exploration',
        'Ruled Out'
      ];
    }

    function isValidUserProfile(docId, data) {
      return data.id == docId &&
        (docId == request.auth.uid || data.userId == request.auth.uid) &&
        data.name is string &&
        data.name.size() > 0 &&
        data.name.size() <= 100 &&
        (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
        (!('activeAccountId' in data) || (data.activeAccountId is string && data.activeAccountId.size() <= 128)) &&
        (!('role' in data) || data.role in ['member', 'admin']) &&
        (!('signupNumber' in data) || data.signupNumber is number) &&
        (!('badges' in data) || (data.badges is list && data.badges.size() <= 50));
    }

    function isValidSavedAccount(ownerUid, accountId, data) {
      return data.id == accountId &&
        (data.userId == ownerUid || isBootstrappedAdmin() || !('userId' in data) || data.userId is string) &&
        data.name is string &&
        data.name.size() > 0 &&
        data.name.size() <= 100 &&
        (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
        (!('username' in data) || (data.username is string && data.username.size() <= 64)) &&
        (!('signupNumber' in data) || data.signupNumber is number) &&
        data.profile is map;
    }

    function isValidSavedAccountDoc(accountId, data) {
      return data.id == accountId &&
        data.name is string &&
        data.name.size() > 0 &&
        data.name.size() <= 100 &&
        (!('userId' in data) || (data.userId is string && data.userId.size() <= 128)) &&
        (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
        (!('username' in data) || (data.username is string && data.username.size() <= 64)) &&
        (!('signupNumber' in data) || data.signupNumber is number) &&
        data.profile is map;
    }

    function isValidJournalEntry(ownerUid, countryId, data) {
      return data.userId == ownerUid &&
        data.countryId == countryId &&
        data.countryName is string &&
        data.countryName.size() > 0 &&
        data.countryName.size() <= 100 &&
        isValidInterestLevel(data.interestLevel) &&
        (!('privateNotes' in data) || (data.privateNotes is string && data.privateNotes.size() <= 5000)) &&
        (!('tags' in data) || (data.tags is list && data.tags.size() <= 20)) &&
        (!('scoutingTimeline' in data) || (data.scoutingTimeline is string && data.scoutingTimeline.size() <= 100));
    }

    function isValidWorkspaceDoc(ownerUid, docId, data) {
      return data.id == docId &&
        data.userId == ownerUid &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 40));
    }

    function isValidFeedbackReport(reportId, data) {
      return data.id == reportId &&
        data.type in ['feedback', 'bug'] &&
        data.status in ['new', 'under_review', 'in_progress', 'resolved', 'closed'] &&
        data.message is string &&
        data.message.size() > 0 &&
        data.message.size() <= 4000;
    }

    function isValidScoutTrip(ownerUid, tripId, data) {
      return data.id == tripId &&
        data.userId == ownerUid &&
        data.title is string &&
        data.title.size() > 0 &&
        data.title.size() <= 200 &&
        data.stops is list &&
        data.stops.size() <= 10 &&
        data.tasks is list &&
        data.tasks.size() <= 100 &&
        data.accommodation is map &&
        data.packingList is list &&
        data.packingList.size() <= 100 &&
        (!('selectedItineraryItems' in data) || (data.selectedItineraryItems is list && data.selectedItineraryItems.size() <= 150)) &&
        (!('selectedInterests' in data) || (data.selectedInterests is list && data.selectedInterests.size() <= 30)) &&
        (!('customHobbies' in data) || (data.customHobbies is list && data.customHobbies.size() <= 30)) &&
        data.totalDays is number &&
        data.schengenDays is number &&
        data.estimatedTotalBurnUSD is number &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 40)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 40));
    }

    // 1. Root /users/{userId} collection: stores primary auth session AND all User IDs (usr-ganesh, usr-elena, usr-marcus, etc.)
    match /users/{userId} {
      allow get: if isValidId(userId);
      allow list: if true;
      allow create: if isValidId(userId) &&
        isValidUserProfile(userId, incoming()) &&
        (!('role' in incoming()) || incoming().role == 'member' || isBootstrappedAdmin());
      allow update: if isValidId(userId) &&
        isValidUserProfile(userId, incoming()) &&
        (!('role' in incoming()) || incoming().role == 'member' || incoming().role == existing().role || isBootstrappedAdmin()) &&
        (isBootstrappedAdmin() || !isSignedIn() || userId == request.auth.uid || existing().userId == request.auth.uid || userId.matches('^usr-.*'));
      allow delete: if isValidId(userId) &&
        (isBootstrappedAdmin() || (isSignedIn() && (userId == request.auth.uid || resource.data.userId == request.auth.uid)));

      // Subcollection: Saved Custom User IDs / Expat Persona Accounts
      match /savedAccounts/{accountId} {
        allow get: if (isOwner(userId) || isBootstrappedAdmin()) && isValidId(userId) && isValidId(accountId);
        allow list: if (isOwner(userId) || isBootstrappedAdmin()) && isValidId(userId);
        allow create: if (isOwner(userId) || isBootstrappedAdmin()) &&
          isValidId(userId) &&
          isValidId(accountId) &&
          isValidSavedAccount(userId, accountId, incoming());
        allow update: if (isOwner(userId) || isBootstrappedAdmin()) &&
          isValidId(userId) &&
          isValidId(accountId) &&
          isValidSavedAccount(userId, accountId, incoming());
        allow delete: if (isOwner(userId) || isBootstrappedAdmin()) &&
          isValidId(userId) &&
          isValidId(accountId);
      }

      // Subcollection: Private Country Journal
      match /journalEntries/{countryId} {
        allow get: if (isOwner(userId) || isBootstrappedAdmin()) && isValidId(userId) && isValidId(countryId);
        allow list: if (isOwner(userId) || isBootstrappedAdmin()) && isValidId(userId);
        allow create: if (isOwner(userId) || isBootstrappedAdmin()) &&
          isValidId(userId) &&
          isValidId(countryId) &&
          isValidJournalEntry(userId, countryId, incoming());
        allow update: if (isOwner(userId) || isBootstrappedAdmin()) &&
          isValidId(userId) &&
          isValidId(countryId) &&
          isValidJournalEntry(userId, countryId, incoming());
        allow delete: if (isOwner(userId) || isBootstrappedAdmin()) &&
          isValidId(userId) &&
          isValidId(countryId);
      }

      // Subcollection: User Workspace state
      match /workspace/{docId} {
        allow get: if (isOwner(userId) || isBootstrappedAdmin()) && isValidId(userId) && isValidId(docId);
        allow list: if (isOwner(userId) || isBootstrappedAdmin()) && isValidId(userId);
        allow create: if (isOwner(userId) || isBootstrappedAdmin()) &&
          isValidId(userId) &&
          isValidId(docId) &&
          isValidWorkspaceDoc(userId, docId, incoming());
        allow update: if (isOwner(userId) || isBootstrappedAdmin()) &&
          isValidId(userId) &&
          isValidId(docId) &&
          isValidWorkspaceDoc(userId, docId, incoming());
        allow delete: if (isOwner(userId) || isBootstrappedAdmin()) &&
          isValidId(userId) &&
          isValidId(docId);
      }

      // Subcollection: Scout Trips & Visa Hopper Roadmaps
      match /trips/{tripId} {
        allow get: if (isOwner(userId) || isBootstrappedAdmin()) && isValidId(userId) && isValidId(tripId);
        allow list: if (isOwner(userId) || isBootstrappedAdmin()) && isValidId(userId);
        allow create: if (isOwner(userId) || isBootstrappedAdmin()) &&
          isValidId(userId) &&
          isValidId(tripId) &&
          isValidScoutTrip(userId, tripId, incoming());
        allow update: if (isOwner(userId) || isBootstrappedAdmin()) &&
          isValidId(userId) &&
          isValidId(tripId) &&
          isValidScoutTrip(userId, tripId, incoming());
        allow delete: if (isOwner(userId) || isBootstrappedAdmin()) &&
          isValidId(userId) &&
          isValidId(tripId);
      }
    }

    // 2. Top-level /savedAccounts/{accountId} collection (All expat community member profiles public across devices)
    match /savedAccounts/{accountId} {
      allow get: if isValidId(accountId);
      allow list: if true;
      allow create: if isValidId(accountId) &&
        isValidSavedAccountDoc(accountId, incoming());
      allow update: if isValidId(accountId) &&
        isValidSavedAccountDoc(accountId, incoming()) &&
        (isBootstrappedAdmin() || !isSignedIn() || resource == null || resource.data.userId == request.auth.uid || accountId == request.auth.uid);
      allow delete: if isValidId(accountId) &&
        (isBootstrappedAdmin() || (isSignedIn() && (resource.data.userId == request.auth.uid || accountId == request.auth.uid)));
    }

    // 3. Top-level /countryJournals/{countryId} collection
    match /countryJournals/{countryId} {
      allow get: if isSignedIn() && isValidId(countryId) && (resource == null || resource.data.userId == request.auth.uid || isBootstrappedAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isBootstrappedAdmin());
      allow create, update: if isSignedIn() &&
        isValidId(countryId) &&
        isValidJournalEntry(request.auth.uid, countryId, incoming());
      allow delete: if isSignedIn() &&
        isValidId(countryId) &&
        (resource.data.userId == request.auth.uid || isBootstrappedAdmin());
    }

    // 4. Top-level /communityThreads/{threadId} collection
    match /communityThreads/{threadId} {
      allow get: if isSignedIn() && isValidId(threadId) && (resource == null || resource.data.userId == request.auth.uid || isBootstrappedAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isBootstrappedAdmin());
      allow create, update: if isSignedIn() &&
        isValidId(threadId) &&
        isValidWorkspaceDoc(request.auth.uid, threadId, incoming());
      allow delete: if isSignedIn() &&
        isValidId(threadId) &&
        (resource.data.userId == request.auth.uid || isBootstrappedAdmin());
    }

    // 5. Top-level /expatMeetups/{meetupId} collection
    match /expatMeetups/{meetupId} {
      allow get: if isSignedIn() && isValidId(meetupId) && (resource == null || resource.data.userId == request.auth.uid || isBootstrappedAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isBootstrappedAdmin());
      allow create, update: if isSignedIn() &&
        isValidId(meetupId) &&
        isValidWorkspaceDoc(request.auth.uid, meetupId, incoming());
      allow delete: if isSignedIn() &&
        isValidId(meetupId) &&
        (resource.data.userId == request.auth.uid || isBootstrappedAdmin());
    }

    // 6. Top-level /relocationChecklists/{accountId} collection
    match /relocationChecklists/{accountId} {
      allow get: if isSignedIn() && isValidId(accountId) && (resource == null || resource.data.userId == request.auth.uid || accountId.matches('^usr-.*') || isBootstrappedAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isBootstrappedAdmin());
      allow create, update: if isSignedIn() &&
        isValidId(accountId) &&
        isValidWorkspaceDoc(request.auth.uid, accountId, incoming());
      allow delete: if isSignedIn() &&
        isValidId(accountId) &&
        (resource.data.userId == request.auth.uid || isBootstrappedAdmin());
    }

    // 7. Top-level /feedbackReports/{reportId} collection
    match /feedbackReports/{reportId} {
      allow get: if isBootstrappedAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isBootstrappedAdmin();
      allow create: if isValidId(reportId) && isValidFeedbackReport(reportId, incoming());
      allow update, delete: if isBootstrappedAdmin();
    }

    // 8. Top-level /platformSettings/{settingId} collection (Publicly readable typography & badge config, writable strictly by Bootstrapped Admin)
    match /platformSettings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if false;
      allow create, update: if isBootstrappedAdmin() &&
        isValidId(settingId) &&
        incoming().id == settingId &&
        incoming().updatedAt is string && incoming().updatedAt.size() <= 40 &&
        (!('updatedBy' in incoming()) || (incoming().updatedBy is string && incoming().updatedBy.size() <= 150)) &&
        (
          (settingId == 'typography' &&
           incoming().presetId is string && incoming().presetId.size() > 0 && incoming().presetId.size() <= 64 &&
           incoming().displayCss is string && incoming().displayCss.size() > 0 && incoming().displayCss.size() <= 200 &&
           incoming().bodyCss is string && incoming().bodyCss.size() > 0 && incoming().bodyCss.size() <= 200 &&
           incoming().monoCss is string && incoming().monoCss.size() > 0 && incoming().monoCss.size() <= 200 &&
           incoming().headingTracking is string && incoming().headingTracking.size() <= 20 &&
           incoming().bodyTracking is string && incoming().bodyTracking.size() <= 20)
          ||
          (settingId == 'badges' &&
           incoming().earlyPioneerThreshold is number &&
           incoming().earlyPioneerThreshold >= 1 &&
           incoming().earlyPioneerThreshold <= 100000)
        );
      allow delete: if isBootstrappedAdmin() && isValidId(settingId);
    }
  }
}
